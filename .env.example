# PostgreSQL. Usa database separati per sviluppo e test.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adelfia_waiting_list?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adelfia_waiting_list_test?schema=public"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# HMAC per il registro anti-reiscrizione. Non riutilizzare BETTER_AUTH_SECRET.
IDENTIFIER_HMAC_KEY="replace-with-an-independent-32-character-secret"
RATE_LIMIT_HMAC_KEY="replace-with-another-independent-32-character-secret"

# Gmail SMTP con OAuth 2.0. I segreti restano esclusivamente server-side.
# Usa l'indirizzo esatto dell'account Gmail/Google Workspace autorizzato.
GMAIL_USER=""
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""

# Margine prudenziale rispetto ai 500 destinatari/giorno di Gmail personale.
# Riducilo se lo stesso account viene usato anche manualmente.
GMAIL_DAILY_RECIPIENT_LIMIT="450"
GMAIL_MAX_RECIPIENTS_PER_MESSAGE="20"
MAIL_FROM_NAME="AGESCI Adelfia 1"
MAIL_REPLY_TO=""

# Usato soltanto da `pnpm run mail:test` per un singolo invio esplicito.
MAIL_TEST_RECIPIENT=""

# Bootstrap del primo Capo Gruppo (script admin:bootstrap).
BOOTSTRAP_ADMIN_FIRST_NAME=""
BOOTSTRAP_ADMIN_LAST_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_MEMBER_CODE=""
BOOTSTRAP_ADMIN_PASSWORD=""

# E2E locale/CI. Usa esclusivamente un database di test isolato.
E2E_ALLOW_RESET="false"
E2E_RESET_SECRET=""
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
E2E_STAFF_EMAIL=""
E2E_STAFF_PASSWORD=""
E2E_STAFF_MEMBER_CODE="E2E-STAFF-001"

# Import/retention
IMPORT_TIMEZONE="Europe/Rome"
RETENTION_DAYS="365"
